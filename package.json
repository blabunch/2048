{
  "name": "2048",
  "version": "1.0.0",
  "description": "Classic 2048 puzzle game built with vanilla JavaScript, SCSS and Parcel",
  "homepage": "https://blabunch.github.io/2048/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blabunch/2048.git"
  },
  "scripts": {
    "init": "mate-scripts init",
    "start": "mate-scripts start",
    "lint": "mate-scripts lint",
    "test:only": "mate-scripts test",
    "build": "mate-scripts build",
    "deploy": "mate-scripts deploy",
    "update": "mate-scripts update",
    "postinstall": "npm run update",
    "test": "npm run lint && npm run test:only",
    "build:pages": "parcel build src/index.html --dist-dir dist --public-url ./ --no-source-maps"
  },
  "keywords": [
    "2048",
    "game",
    "puzzle",
    "javascript",
    "parcel"
  ],
  "author": "Bohdan Labunets",
  "license": "GPL-3.0",
  "devDependencies": {
    "@linthtml/linthtml": "^0.9.6",
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/linthtml-config": "latest",
    "@mate-academy/scripts": "^2.1.3",
    "@mate-academy/stylelint-config": "latest",
    "@parcel/transformer-sass": "^2.12.0",
    "eslint": "^8.57.0",
    "eslint-plugin-node": "^11.1.0",
    "parcel": "^2.12.0",
    "prettier": "^3.3.2",
    "stylelint": "^16.7.0",
    "stylelint-scss": "^6.4.1"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "mateAcademy": {
    "projectType": "layout",
    "linters": {
      "bem": false
    }
  }
}
